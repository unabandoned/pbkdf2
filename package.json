{
  "name": "@unabandoned/pbkdf2",
  "version": "3.2.3",
  "description": "This library provides the functionality of PBKDF2 with the ability to use any supported hashing algorithm returned from crypto.getHashes()",
  "keywords": [
    "pbkdf2",
    "kdf",
    "salt",
    "hash"
  ],
  "homepage": "https://github.com/unabandoned/pbkdf2#readme",
  "bugs": {
    "url": "https://github.com/unabandoned/pbkdf2/issues"
  },
  "license": "MIT",
  "author": "Daniel Cousens",
  "browser": {
    "./index.js": "./browser.js",
    "./lib/sync.js": "./lib/sync-browser.js"
  },
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unabandoned/pbkdf2.git"
  },
  "scripts": {
    "test": "node --test test/index.js test/iteration-guard.js test/to-buffer.js",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "semver": "7.8.5",
    "@types/node": "25.9.8",
    "typescript": "next"
  },
  "dependencies": {
    "@unabandoned/hash.js": "^1.4.0",
    "safe-buffer": "^5.2.1"
  },
  "engines": {
    "node": ">= 0.10"
  },
  "auto-changelog": {
    "output": "CHANGELOG.md",
    "template": "keepachangelog",
    "unreleased": false,
    "commitLimit": false,
    "backfillLimit": false,
    "hideCredit": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "overrides": {
    "fflate": "=0.8.3"
  }
}
